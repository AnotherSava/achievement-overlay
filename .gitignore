# Build output
bin/
obj/
publish/
__pycache__/

# Claude Code
.claude/settings.local.json

# Local docs — ignore all except plans and the pages the README links to
docs/*
!docs/plans/
!docs/screenshots/
!docs/gbe-reference.md
!docs/playnite.md

# Runtime config (generated on first run)
config.json

# Local deploy config (machine-specific install path)
config/deploy.env

# Local development config (overrides default.json; holds personal Steam Web API key / Firecrawl API key)
config/local.json

# Dev scripts
/scripts/
