<Window x:Class="AchievementOverlay.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        ThemeMode="System"
        Title="Achievement Overlay — Settings"
        Width="900" Height="1140" MinWidth="720" MinHeight="420"
        WindowStartupLocation="CenterScreen">
    <!-- ThemeMode="System" gives the Fluent control styles and follows the OS light/dark setting,
         so combo boxes, sliders and buttons need no styling of their own. Only the chrome the
         theme has no opinion about - nav rows and setting cards - is defined here. -->
    <Window.Resources>
        <Style x:Key="PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>
        <Style x:Key="PageIntro" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.75" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,0,0,18" />
        </Style>
        <Style x:Key="SectionHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="CardDescription" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Opacity" Value="0.75" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource CardBackground}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="Margin" Value="0,0,0,4" />
        </Style>

        <!-- Windows has no toggle switch control in WPF, so the design's switch is templated here. -->
        <Style x:Key="ToggleSwitch" TargetType="ToggleButton">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="20" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Track" CornerRadius="10"
                                Background="{DynamicResource SwitchOff}"
                                BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
                            <Ellipse x:Name="Knob" Width="12" Height="12" Margin="4,0,0,0"
                                     HorizontalAlignment="Left" VerticalAlignment="Center"
                                     Fill="{DynamicResource SwitchKnobOff}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,4,0" />
                                <Setter TargetName="Knob" Property="Fill" Value="White" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- A colour choice. The ring is always drawn, so a swatch that happens to match the card
             behind it is still a visible control. -->
        <Style x:Key="Swatch" TargetType="Button">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Ring" CornerRadius="4" BorderThickness="1"
                                BorderBrush="{DynamicResource CardBorder}"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="selected">
                                <Setter TargetName="Ring" Property="BorderThickness" Value="2" />
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- One region of the display. The bar standing for the popup is aligned to the corner or edge
             the cell means, so the six of them inside one frame are a picture of where a popup lands —
             six identically centred bars would have left the highlight doing all the work. The cell
             itself is drawn only on hover and selection: resting boxes made the frame read as six
             buttons rather than as one screen. -->
        <Style x:Key="PositionCell" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Cell" CornerRadius="3" Background="Transparent" Padding="4">
                            <!-- 27 × 8 is the popup's own 322 × 95 proportion, and the small radius
                                 echoes its CornerRadius="8" — so these read as notifications rather
                                 than as generic markers. -->
                            <Rectangle x:Name="Bar" Width="27" Height="8" RadiusX="2" RadiusY="2"
                                       Fill="{DynamicResource SwitchKnobOff}" Opacity="0.5"
                                       HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                       VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Cell" Property="Background" Value="{DynamicResource NavHover}" />
                                <Setter TargetName="Bar" Property="Opacity" Value="1" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Cell" Property="Background" Value="{DynamicResource NavHover}" />
                            </Trigger>
                            <!-- Every popup is drawn the same size, so the frame stays an honest picture
                                 of the display: the chosen one differs by being the accent colour at
                                 full strength against the others' half-strength grey. No cell fill —
                                 a filled rectangle behind one bar reads as a floating panel and breaks
                                 the frame's "this is your display" reading. -->
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bar" Property="Fill" Value="{DynamicResource Accent}" />
                                <Setter TargetName="Bar" Property="Opacity" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="NavItem" TargetType="ListBoxItem">
            <Setter Property="Height" Value="36" />
            <Setter Property="Padding" Value="12,0,0,0" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" CornerRadius="4" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <Grid>
                                <Rectangle x:Name="Marker" Width="3" Height="16" RadiusX="2" RadiusY="2"
                                           HorizontalAlignment="Left" Margin="-9,0,0,0"
                                           Fill="{DynamicResource Accent}" Visibility="Collapsed" />
                                <ContentPresenter x:Name="Label" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource NavHover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource NavSelected}" />
                                <Setter TargetName="Marker" Property="Visibility" Value="Visible" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource WindowBackground}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="196" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <ListBox x:Name="Nav" Grid.Column="0" Margin="8,4,8,12"
                 Background="Transparent" BorderThickness="0"
                 ItemContainerStyle="{StaticResource NavItem}"
                 SelectedIndex="0" SelectionChanged="OnNavChanged">
            <ListBoxItem Content="General" />
            <ListBoxItem Content="Notifications" />
            <ListBoxItem Content="Folders" />
            <ListBoxItem Content="Advanced" />
        </ListBox>

        <Border Grid.Column="1" Background="{DynamicResource PageBackground}"
                BorderBrush="{DynamicResource CardBorder}" BorderThickness="1,0,0,0" CornerRadius="8,0,0,0">
            <DockPanel>
                <!-- Footer is full-bleed across the content pane, as in the design. -->
                <Border DockPanel.Dock="Bottom" Background="{DynamicResource WindowBackground}"
                        BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,1,0,0" Padding="26,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="ShowMeButton" Grid.Column="0" Content="▶  Show me" Padding="12,4"
                                Click="OnShowMe" Visibility="Collapsed" />
                        <TextBlock x:Name="PopupSizeText" Grid.Column="1" VerticalAlignment="Center"
                                   Margin="16,0" FontSize="12" Opacity="0.75"
                                   TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button x:Name="SaveButton" Content="Save" MinWidth="90" Padding="14,4"
                                    IsDefault="True" Click="OnSave" Margin="0,0,8,0" />
                            <Button x:Name="CancelButton" Content="Cancel" MinWidth="90" Padding="14,4"
                                    IsCancel="True" Click="OnCancel" />
                        </StackPanel>
                    </Grid>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="26,22,26,0">
                    <Grid>
                        <!-- ==================== General ==================== -->
                        <StackPanel x:Name="GeneralPage">
                            <TextBlock Style="{StaticResource PageTitle}" Text="General" />
                            <TextBlock Style="{StaticResource PageIntro}" Text="Startup, and the panel that shows what you missed." />

                            <Border Style="{StaticResource Card}">
                                <DockPanel>
                                    <ToggleButton x:Name="StartWithWindowsToggle" DockPanel.Dock="Right"
                                                  Style="{StaticResource ToggleSwitch}" Margin="18,0,0,0" />
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource CardTitle}" Text="Start with Windows" />
                                        <TextBlock Style="{StaticResource CardDescription}"
                                                   Text="Runs the overlay in the tray at sign-in. Kept in the registry rather than in config.json." />
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <DockPanel>
                                    <TextBox x:Name="ShortcutBox" DockPanel.Dock="Right" Width="156" Height="32"
                                             VerticalContentAlignment="Center" IsReadOnly="True" Margin="18,0,0,0"
                                             GotKeyboardFocus="OnShortcutFocus" LostKeyboardFocus="OnShortcutBlur"
                                             PreviewKeyDown="OnShortcutKeyDown" />
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource CardTitle}" Text="Show recent achievements" />
                                        <TextBlock Style="{StaticResource CardDescription}"
                                                   Text="Click the field, then press a combination — it's recorded, not typed, so you can take one another app already owns. Backspace clears it; the tray menu still opens the panel." />
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                                        <TextBox x:Name="RecentCountBox" Width="56" Height="32" VerticalContentAlignment="Center"
                                                 TextAlignment="Center" PreviewTextInput="OnDigitsOnly" />
                                        <StackPanel Width="26" Margin="2,0,0,0">
                                            <RepeatButton Content="▲" FontSize="8" Height="16" Padding="0" Click="OnRecentCountUp" />
                                            <RepeatButton Content="▼" FontSize="8" Height="16" Padding="0" Click="OnRecentCountDown" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource CardTitle}" Text="How many to show" />
                                        <TextBlock Style="{StaticResource CardDescription}" Text="Most recent unlocks in that panel, 1 to 20." />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </StackPanel>

                        <!-- ==================== Notifications ==================== -->
                        <StackPanel x:Name="NotificationsPage" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource PageTitle}" Text="Notifications" />
                            <TextBlock Style="{StaticResource PageIntro}"
                                       Text="What a popup says, how it's drawn, and how long it stays. Show me fires a real one; saving applies everything at once." />

                            <TextBlock Style="{StaticResource SectionHeading}" Text="Text &amp; appearance" />

                            <Border Style="{StaticResource Card}">
                                <DockPanel>
                                    <ComboBox x:Name="LanguageBox" DockPanel.Dock="Right" Width="156" Height="32"
                                              IsEditable="True" Margin="18,0,0,0" VerticalAlignment="Center" />
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource CardTitle}" Text="Achievement text" />
                                        <TextBlock Style="{StaticResource CardDescription}"
                                                   Text="Lists only the languages your games carry. Anything missing falls back to english." />
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <DockPanel>
                                    <ComboBox x:Name="FontBox" DockPanel.Dock="Right" Width="156" Height="32"
                                              IsEditable="True" Margin="18,0,0,0" VerticalAlignment="Center" />
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource CardTitle}" Text="Font" />
                                        <TextBlock Style="{StaticResource CardDescription}"
                                                   Text="A shortlist of families that cover the languages above." />
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Padding="0">
                                <StackPanel>
                                    <DockPanel Margin="14,12">
                                        <ComboBox x:Name="ScaleUnitBox" DockPanel.Dock="Right" Width="156" Height="32"
                                                  Margin="18,0,0,0" VerticalAlignment="Center"
                                                  SelectionChanged="OnScaleUnitChanged">
                                            <ComboBoxItem Content="% of screen width" />
                                            <ComboBoxItem Content="Pixels" />
                                        </ComboBox>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource CardTitle}" Text="Popup size" />
                                            <TextBlock Style="{StaticResource CardDescription}"
                                                       Text="Scales text, icon and padding together — reach for this if notifications read too small. A share of the screen adapts to the monitor; pixels pin one width." />
                                        </StackPanel>
                                    </DockPanel>
                                    <Border BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,1,0,0" Padding="14,10">
                                        <DockPanel>
                                            <TextBlock x:Name="ScaleValueText" DockPanel.Dock="Right" Width="76"
                                                       TextAlignment="Right" VerticalAlignment="Center" FontSize="13" Opacity="0.75" />
                                            <Slider x:Name="ScaleSlider" IsSnapToTickEnabled="True"
                                                    VerticalAlignment="Center" Margin="0,0,8,0"
                                                    ValueChanged="OnScaleValueChanged" />
                                        </DockPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Padding="0">
                                <StackPanel>
                                    <DockPanel Margin="14,12">
                                        <StackPanel x:Name="BackgroundSwatches" DockPanel.Dock="Right"
                                                    Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center" />
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource CardTitle}" Text="Popup background" />
                                            <TextBlock Style="{StaticResource CardDescription}"
                                                       Text="The panel behind the text. Text colours are derived from it, so a light background flips them to dark." />
                                        </StackPanel>
                                    </DockPanel>
                                    <Border BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,1,0,0" Padding="14,10">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Left" Text="Opacity" VerticalAlignment="Center"
                                                       FontSize="13" Width="66" />
                                            <TextBlock x:Name="OpacityValueText" DockPanel.Dock="Right" Width="76"
                                                       TextAlignment="Right" VerticalAlignment="Center" FontSize="13" Opacity="0.75" />
                                            <Slider x:Name="OpacitySlider" IsSnapToTickEnabled="True" TickFrequency="1"
                                                    VerticalAlignment="Center" Margin="0,0,8,0"
                                                    ValueChanged="OnOpacityChanged" />
                                        </DockPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <DockPanel>
                                    <!-- The frame is the display, at roughly a display's proportions. -->
                                    <Border DockPanel.Dock="Right" Width="156" Height="88" Margin="18,0,0,0"
                                            VerticalAlignment="Center" CornerRadius="4" Padding="2"
                                            Background="{DynamicResource WindowBackground}"
                                            BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
                                        <UniformGrid Rows="2" Columns="3">
                                            <RadioButton x:Name="PosTopLeft" GroupName="Position" Style="{StaticResource PositionCell}"
                                                         HorizontalContentAlignment="Left" VerticalContentAlignment="Top"
                                                         ToolTip="Top left" AutomationProperties.Name="Top left" />
                                            <RadioButton x:Name="PosTopCenter" GroupName="Position" Style="{StaticResource PositionCell}"
                                                         HorizontalContentAlignment="Center" VerticalContentAlignment="Top"
                                                         ToolTip="Top centre" AutomationProperties.Name="Top centre" />
                                            <RadioButton x:Name="PosTopRight" GroupName="Position" Style="{StaticResource PositionCell}"
                                                         HorizontalContentAlignment="Right" VerticalContentAlignment="Top"
                                                         ToolTip="Top right" AutomationProperties.Name="Top right" />
                                            <RadioButton x:Name="PosBottomLeft" GroupName="Position" Style="{StaticResource PositionCell}"
                                                         HorizontalContentAlignment="Left" VerticalContentAlignment="Bottom"
                                                         ToolTip="Bottom left" AutomationProperties.Name="Bottom left" />
                                            <RadioButton x:Name="PosBottomCenter" GroupName="Position" Style="{StaticResource PositionCell}"
                                                         HorizontalContentAlignment="Center" VerticalContentAlignment="Bottom"
                                                         ToolTip="Bottom centre" AutomationProperties.Name="Bottom centre" />
                                            <RadioButton x:Name="PosBottomRight" GroupName="Position" Style="{StaticResource PositionCell}"
                                                         HorizontalContentAlignment="Right" VerticalContentAlignment="Bottom"
                                                         ToolTip="Bottom right" AutomationProperties.Name="Bottom right" />
                                        </UniformGrid>
                                    </Border>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource CardTitle}" Text="Popup position" />
                                        <TextBlock Style="{StaticResource CardDescription}"
                                                   Text="Where popups appear, and where the recent achievements panel stacks from. Relative to the display, not to the game's own window." />
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <TextBlock Style="{StaticResource SectionHeading}" Text="Timing &amp; sound" Margin="0,22,0,8" />

                            <Border Style="{StaticResource Card}">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="18,0,0,0" VerticalAlignment="Center">
                                        <Slider x:Name="DurationSlider" Width="120" Minimum="1" Maximum="30"
                                                IsSnapToTickEnabled="True" TickFrequency="1"
                                                VerticalAlignment="Center" ValueChanged="OnDurationChanged" />
                                        <TextBlock x:Name="DurationText" Width="40" Margin="12,0,0,0"
                                                   VerticalAlignment="Center" FontSize="14" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource CardTitle}" Text="Display duration" />
                                        <TextBlock Style="{StaticResource CardDescription}" Text="How long it stays on screen, 1 to 30 seconds." />
                                    </StackPanel>
                                </DockPanel>
                            </Border>

                            <Border Style="{StaticResource Card}" Padding="0">
                                <StackPanel>
                                    <DockPanel Margin="14,12">
                                        <ToggleButton x:Name="SoundToggle" DockPanel.Dock="Right"
                                                      Style="{StaticResource ToggleSwitch}" Margin="18,0,0,0"
                                                      Checked="OnSoundToggled" Unchecked="OnSoundToggled" />
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource CardTitle}" Text="Play a sound on unlock" />
                                            <TextBlock Style="{StaticResource CardDescription}" Text="Plays once per achievement, alongside the popup." />
                                        </StackPanel>
                                    </DockPanel>
                                    <Border BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,1,0,0" Padding="14,12">
                                        <StackPanel x:Name="SoundChoiceRows">
                                            <RadioButton x:Name="BuiltInSoundRadio" Content="Built-in sound" GroupName="Sound"
                                                         Checked="OnSoundChoiceChanged" Margin="0,0,0,10" />
                                            <DockPanel>
                                                <RadioButton x:Name="CustomSoundRadio" Content="Custom file" GroupName="Sound"
                                                             DockPanel.Dock="Left" VerticalAlignment="Center"
                                                             Checked="OnSoundChoiceChanged" Margin="0,0,12,0" />
                                                <Button x:Name="SoundBrowseButton" DockPanel.Dock="Right" Content="Browse"
                                                        Padding="12,4" Margin="8,0,0,0" Click="OnBrowseSound" />
                                                <TextBox x:Name="SoundPathBox" Height="32" VerticalContentAlignment="Center" />
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <TextBlock Style="{StaticResource SectionHeading}" Text="Each game's own settings" Margin="0,22,0,8" />

                            <Border Style="{StaticResource Card}">
                                <DockPanel>
                                    <ToggleButton x:Name="GameOverlaySettingsToggle" DockPanel.Dock="Right"
                                                  Style="{StaticResource ToggleSwitch}" Margin="18,0,0,0" />
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource CardTitle}" Text="Use each game's own overlay settings" />
                                        <TextBlock Style="{StaticResource CardDescription}"
                                                   Text="Some games arrive with an unlock sound, font or duration already set in their steam_settings folder. Those are used for that game; everything above still covers the rest." />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </StackPanel>

                        <!-- ==================== Folders ==================== -->
                        <StackPanel x:Name="FoldersPage" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource PageTitle}" Text="Folders" />
                            <TextBlock Style="{StaticResource PageIntro}" Text="Where games live, and where the emulator writes unlocks." />

                            <TextBlock Style="{StaticResource SectionHeading}" Text="Game folders" Margin="0,0,0,2" />
                            <TextBlock Style="{StaticResource CardDescription}" Margin="0,0,0,8"
                                       Text="Scanned for games with a steam_appid.txt and a steam_settings/achievements.json." />
                            <ItemsControl x:Name="GameFoldersList" />
                            <Button Content="+  Add folder" HorizontalAlignment="Left" Padding="14,5" Margin="0,2,0,0"
                                    Click="OnAddGameFolder" />

                            <TextBlock Style="{StaticResource SectionHeading}" Text="GSE Saves folders" Margin="0,24,0,2" />
                            <TextBlock Style="{StaticResource CardDescription}" Margin="0,0,0,8"
                                       Text="Watched for unlocks. At least one has to exist, or the app won't start. Variables like %appdata% are kept as written." />
                            <ItemsControl x:Name="SavesFoldersList" />
                            <Button Content="+  Add folder" HorizontalAlignment="Left" Padding="14,5" Margin="0,2,0,0"
                                    Click="OnAddSavesFolder" />
                        </StackPanel>

                        <!-- ==================== Advanced ==================== -->
                        <StackPanel x:Name="AdvancedPage" Visibility="Collapsed">
                            <TextBlock Style="{StaticResource PageTitle}" Text="Advanced" />
                            <TextBlock Style="{StaticResource PageIntro}"
                                       Text="Keys the Add game wizard asks for once and reuses. Both are stored in plain text in config.json." />

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" x:Name="SteamKeyReveal" Text="Show"
                                                   Foreground="{DynamicResource Accent}" Cursor="Hand" FontSize="13"
                                                   MouseLeftButtonUp="OnToggleSteamKeyReveal" />
                                        <TextBlock Style="{StaticResource CardTitle}" Text="Steam Web API key" />
                                    </DockPanel>
                                    <Grid Margin="0,8,0,0">
                                        <PasswordBox x:Name="SteamKeyMasked" Height="32" VerticalContentAlignment="Center" />
                                        <TextBox x:Name="SteamKeyPlain" Height="32" VerticalContentAlignment="Center" Visibility="Collapsed" />
                                    </Grid>
                                    <TextBlock Style="{StaticResource CardDescription}" Margin="0,8,0,0"
                                               Text="Fetches achievement schemas and icons while adding a game. Get one at steamcommunity.com/dev/apikey — it's only needed during that, so you can revoke it straight after." />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="optional" Opacity="0.75" FontSize="13" />
                                        <TextBlock Style="{StaticResource CardTitle}" Text="Firecrawl API key" />
                                    </DockPanel>
                                    <TextBox x:Name="FirecrawlKeyBox" Height="32" VerticalContentAlignment="Center" Margin="0,8,0,0" />
                                    <TextBlock Style="{StaticResource CardDescription}" Margin="0,8,0,0"
                                               Text="Fills in hidden-achievement descriptions from SteamDB. Leave it empty and those stay as placeholders." />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</Window>
