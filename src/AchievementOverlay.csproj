<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Assets\icon.ico</ApplicationIcon>
    <AssemblyName>AchievementOverlay</AssemblyName>
    <RootNamespace>AchievementOverlay</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="AchievementOverlay.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SharpCompress" Version="0.*" />
  </ItemGroup>

  <ItemGroup>
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\achievement_sound.wav" LogicalName="AchievementOverlay.achievement_sound.wav" />
    <EmbeddedResource Include="Assets\icon.ico" LogicalName="AchievementOverlay.icon.ico" />
    <EmbeddedResource Include="Assets\connoisseur.jpg" LogicalName="AchievementOverlay.connoisseur.jpg" />
  </ItemGroup>

  <!--
    config.json shipped next to the exe. For local builds/deploys, a gitignored config\local.json
    (with your real Steam Web API key / Firecrawl API key) takes precedence; otherwise the committed
    config\default.json is used (e.g. on CI / release builds, where local.json doesn't exist).
  -->
  <ItemGroup Condition="Exists('..\config\local.json')">
    <None Include="..\config\local.json" Link="config.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="!Exists('..\config\local.json')">
    <None Include="..\config\default.json" Link="config.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
