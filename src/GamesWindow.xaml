<Window x:Class="AchievementOverlay.GamesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        ThemeMode="System"
        Title="Achievement Overlay — Games"
        Width="1100" Height="560" MinWidth="760" MinHeight="360"
        WindowStartupLocation="CenterScreen">
    <!-- Built like the settings and report windows: ThemeMode="System" styles the controls and follows
         the OS light/dark switch, DialogChrome supplies the chrome colours the theme has no key for. -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/AchievementOverlay;component/DialogStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="Visible" />
            <!-- Text columns draw a bare TextBlock at the top of the cell; the template columns centre theirs. -->
            <!-- A folder cell opens its folder on a double-click, which its tooltip says under the path. The cell's
                 TextBlock carries the path in its Tag, and a transparent background so the whole cell answers, not
                 only the text. Not shared, since one ToolTip cannot belong to every cell at once. -->
            <ToolTip x:Key="FolderTip" x:Shared="False">
                <StackPanel>
                    <TextBlock Text="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource AncestorType=ToolTip}}" />
                    <TextBlock Text="Double-click to open in Explorer" Opacity="0.75" Margin="0,2,0,0" />
                </StackPanel>
            </ToolTip>
            <Style x:Key="FolderCell" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="12,0,12,0" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="ToolTip" Value="{StaticResource FolderTip}" />
                <EventSetter Event="MouseLeftButtonDown" Handler="OnFolderMouseDown" />
                <Style.Triggers>
                    <!-- An empty cell has no folder to name or open. -->
                    <Trigger Property="Text" Value="">
                        <Setter Property="ToolTipService.IsEnabled" Value="False" />
                    </Trigger>
                </Style.Triggers>
            </Style>
            <!-- Every cell's text sits 12 px in from both edges, matching the headers' padding, so a column's text lines
                 up under its name and the first column does not start flush against the table's border. -->
            <Style x:Key="CellText" TargetType="TextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Margin" Value="12,0,12,0" />
            </Style>
            <!-- Numbers and intervals line up on their last digit, so their columns align right, header included. -->
            <Style x:Key="CellNumber" TargetType="TextBlock" BasedOn="{StaticResource CellText}">
                <Setter Property="HorizontalAlignment" Value="Right" />
            </Style>
            <Style x:Key="HeaderRight" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                <Setter Property="HorizontalContentAlignment" Value="Right" />
                <Setter Property="Padding" Value="12,6,12,6" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{DynamicResource WindowBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="20,16,20,12">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Add game…" MinWidth="110" Padding="14,4" Click="OnAddGame" Margin="0,0,8,0" />
                <Button Content="Columns…" MinWidth="110" Padding="14,4" Click="OnColumns" />
            </StackPanel>
            <TextBlock Text="Games" Style="{StaticResource PageTitle}" Margin="0" VerticalAlignment="Center" />
        </DockPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" Margin="20,0,20,0">
            <DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                      SelectionMode="Single" GridLinesVisibility="None" BorderThickness="0" Background="Transparent"
                      CanUserResizeRows="False" CanUserAddRows="False" CanUserDeleteRows="False" SelectionUnit="FullRow">
                <DataGrid.Resources>
                    <!-- A row's own buttons open dialogs, which take the focus; with the default inactive colours the
                         row they were clicked on would turn grey at that moment, so the selection keeps its active colours. -->
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="{DynamicResource {x:Static SystemColors.HighlightColorKey}}" />
                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightTextBrushKey}" Color="{DynamicResource {x:Static SystemColors.HighlightTextColorKey}}" />
                </DataGrid.Resources>
                <DataGrid.ColumnHeaderStyle>
                    <Style TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                        <Setter Property="Padding" Value="12,6,12,6" />
                    </Style>
                </DataGrid.ColumnHeaderStyle>
                <DataGrid.RowStyle>
                    <Style TargetType="DataGridRow" BasedOn="{StaticResource {x:Type DataGridRow}}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Choice.Unconfigured}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource RowNotSetUp}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </DataGrid.RowStyle>
                <DataGrid.CellStyle>
                    <!-- A single cell's focus box says nothing: rows are what the window is about. -->
                    <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    </Style>
                </DataGrid.CellStyle>
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Game" Width="2*" SortMemberPath="Name">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" ToolTip="{Binding Name}" TextTrimming="CharacterEllipsis" Style="{StaticResource CellText}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <!-- A glyph in a drawn circle, like Report a problem's notice badge, so it cannot depend on an icon
                         font: a check when every config check passes, "!" with the problems on hover when one fails,
                         nothing for a game not set up, which has no config to check. -->
                    <DataGridTemplateColumn x:Name="ConfigColumn" Header="" Width="Auto" MinWidth="40" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Grid Width="18" Height="18" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip="{Binding ConfigTooltip}" AutomationProperties.Name="{Binding ConfigLabel}" Background="Transparent">
                                    <Grid Visibility="{Binding ConfigComplete, Converter={StaticResource Visible}}">
                                        <Ellipse Fill="{DynamicResource StatusGood}" />
                                        <TextBlock Text="✓" Foreground="White" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                    <Grid Visibility="{Binding ConfigIncomplete, Converter={StaticResource Visible}}">
                                        <Ellipse Fill="{DynamicResource StatusWarn}" />
                                        <TextBlock Text="!" Foreground="White" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
                                    </Grid>
                                </Grid>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn x:Name="EmulatorColumn" Header="Emulator" Binding="{Binding Emulator}" ElementStyle="{StaticResource CellText}" Width="Auto" MinWidth="90" />
                    <DataGridTextColumn x:Name="AchievementsColumn" Header="Achievements" Binding="{Binding Achievements}" ElementStyle="{StaticResource CellNumber}" HeaderStyle="{StaticResource HeaderRight}" Width="Auto" MinWidth="100" />
                    <DataGridTemplateColumn x:Name="LastUnlockColumn" Header="Last unlock" Width="Auto" MinWidth="90" SortMemberPath="LastUnlockTime" HeaderStyle="{StaticResource HeaderRight}">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding LastUnlock}" ToolTip="{Binding LastUnlockExact}" Style="{StaticResource CellNumber}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn x:Name="AppIdColumn" Header="AppID" Binding="{Binding AppId}" ElementStyle="{StaticResource CellNumber}" HeaderStyle="{StaticResource HeaderRight}" Width="Auto" MinWidth="70" />
                    <DataGridTemplateColumn x:Name="GameFolderColumn" Header="Game folder" Width="3*" SortMemberPath="GameFolder">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding GameFolder}" Tag="{Binding GameFolder}" Style="{StaticResource FolderCell}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn x:Name="SaveFolderColumn" Header="Save folder" Width="3*" SortMemberPath="SaveFolder">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding SaveFolder}" Tag="{Binding SaveFolder}" Style="{StaticResource FolderCell}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Width="Auto" CanUserSort="False">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <!-- The row's actions behind one "more" button, as Windows lists show them. A plain
                                     character rather than an icon font, so it cannot depend on Segoe Fluent Icons. -->
                                <Button Content="⋯" Click="OnRowMenu" Padding="10,0,10,4" Margin="4,2" FontSize="16"
                                        ToolTip="Actions" AutomationProperties.Name="Actions" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="2" Padding="20,12">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Close" MinWidth="90" Padding="14,4" IsCancel="True" />
                <TextBlock x:Name="Status" FontSize="12" Opacity="0.75" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
