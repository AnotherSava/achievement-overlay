<Window x:Class="AchievementOverlay.DiagnosticReportWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        ThemeMode="System"
        Title="Achievement Overlay — Report a problem"
        Width="1000" Height="720" MinWidth="780" MinHeight="520"
        WindowStartupLocation="CenterScreen">
    <!-- Built the same way as the settings window: ThemeMode="System" supplies every control's look
         and the OS light/dark switch, DialogChrome supplies the chrome colours the theme has no key
         for, and the nav rail owns its own row template. Owning that template is the point: a stock
         tab strip gives the open part almost no contrast against its neighbours, and which part is
         open is the thing this control most needs to say.

         One page rather than five: unlike the settings pages, these five differ only in the data they
         show, so a page per part would be five copies of one layout drifting apart. The rail picks a
         part and the page is written from it. -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/AchievementOverlay;component/DialogStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid Background="{DynamicResource WindowBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- The game choice governs all five parts, and the rail with them, so it sits above both
             columns rather than inside the pane showing one of them. -->
        <Border Grid.Row="0" Padding="20,14,20,12">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="Game" VerticalAlignment="Center"
                           FontSize="14" Margin="0,0,12,0" />
                <ComboBox x:Name="GameBox" Width="380" Height="32" HorizontalAlignment="Left"
                          VerticalContentAlignment="Center" SelectionChanged="OnGameChanged" />
            </DockPanel>
        </Border>

        <!-- The one thing here that is a warning rather than a description, so it is the one thing
             not drawn as quiet grey help text. It carries only what the per-part lines do not: those
             already say the keys are replaced and the other games are left out.

             Both facts are GitHub's own, from docs.github.com "Attaching files": "For public
             repositories, uploaded files can be accessed without authentication", and "When you attach
             a file, it is uploaded immediately to GitHub and the text field is updated to show the
             anonymized URL for the file". The second is the one worth the space - dropping the file in
             has already published it, whether or not the comment is ever posted. Nothing is said about
             deleting an attachment because GitHub's documentation does not say.

             It leads with what to do and follows with why. An earlier draft opened straight onto the
             GitHub facts, which left a warning that never asked for anything; the one before that
             opened "whoever you send it to can see everything in it", which asks for something but
             justifies it with a tautology.

             The mark is a badge, not a bar. An accent bar here was the rail's own selected-row marker
             sitting directly above the rail, so two identical marks a few pixels apart meant "this row
             is selected" and "this is important" - a marker only means something by being unlike the
             others. The band has its own tint for the same reason: NavSelected is the selected row's
             colour. The glyph is a plain character rather than an icon font, so it cannot depend on
             Segoe Fluent Icons being present. -->
        <Border Grid.Row="1" Background="{DynamicResource NoticeBackground}"
                BorderBrush="{DynamicResource NoticeBorder}" BorderThickness="0,1,0,1">
            <DockPanel Margin="20,10">
                <Grid DockPanel.Dock="Left" Width="16" Height="16" VerticalAlignment="Center" Margin="0,0,10,0">
                    <Ellipse Fill="{DynamicResource Accent}" />
                    <TextBlock Text="!" Foreground="White" FontSize="11" FontWeight="Bold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,-1,0,0" />
                </Grid>
                <TextBlock x:Name="PrivacyNote" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center"
                           Text="Read each part before you send this file. Attaching it to a GitHub issue publishes it: on a public repository anyone can read an uploaded file without a GitHub account, and GitHub uploads it the moment you drop it in, before you post the comment." />
            </DockPanel>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="208" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListBox x:Name="Nav" Grid.Column="0" Margin="8,10,8,12"
                     Background="Transparent" BorderThickness="0"
                     ItemContainerStyle="{StaticResource NavItem}"
                     SelectedIndex="0" SelectionChanged="OnNavChanged">
                <ListBoxItem x:Name="Row0">
                    <DockPanel>
                        <TextBlock x:Name="Chip0" DockPanel.Dock="Right" Text="left out" FontSize="11"
                                   Opacity="0.75" VerticalAlignment="Center" Margin="8,0,10,0" Visibility="Collapsed" />
                        <TextBlock x:Name="Label0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </ListBoxItem>
                <ListBoxItem x:Name="Row1">
                    <DockPanel>
                        <TextBlock x:Name="Chip1" DockPanel.Dock="Right" Text="left out" FontSize="11"
                                   Opacity="0.75" VerticalAlignment="Center" Margin="8,0,10,0" Visibility="Collapsed" />
                        <TextBlock x:Name="Label1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </ListBoxItem>
                <ListBoxItem x:Name="Row2">
                    <DockPanel>
                        <TextBlock x:Name="Chip2" DockPanel.Dock="Right" Text="left out" FontSize="11"
                                   Opacity="0.75" VerticalAlignment="Center" Margin="8,0,10,0" Visibility="Collapsed" />
                        <TextBlock x:Name="Label2" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </ListBoxItem>
                <ListBoxItem x:Name="Row3">
                    <DockPanel>
                        <TextBlock x:Name="Chip3" DockPanel.Dock="Right" Text="left out" FontSize="11"
                                   Opacity="0.75" VerticalAlignment="Center" Margin="8,0,10,0" Visibility="Collapsed" />
                        <TextBlock x:Name="Label3" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </ListBoxItem>
                <ListBoxItem x:Name="Row4">
                    <DockPanel>
                        <TextBlock x:Name="Chip4" DockPanel.Dock="Right" Text="left out" FontSize="11"
                                   Opacity="0.75" VerticalAlignment="Center" Margin="8,0,10,0" Visibility="Collapsed" />
                        <TextBlock x:Name="Label4" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    </DockPanel>
                </ListBoxItem>
            </ListBox>

            <Border Grid.Column="1" Background="{DynamicResource PageBackground}"
                    BorderBrush="{DynamicResource CardBorder}" BorderThickness="1,0,0,0" CornerRadius="8,0,0,0">
                <DockPanel>
                    <Border DockPanel.Dock="Bottom" Background="{DynamicResource WindowBackground}"
                            BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,1,0,0" Padding="26,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="FooterStatus" Grid.Column="0" VerticalAlignment="Center"
                                       Margin="0,0,16,0" FontSize="12" Opacity="0.75"
                                       TextTrimming="CharacterEllipsis" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <!-- No IsDefault: Enter must not open a file dialog from a window whose
                                     whole purpose is reading before sending. -->
                                <Button x:Name="CopyButton" Content="Copy" MinWidth="90" Padding="14,4"
                                        Click="OnCopy" Margin="0,0,8,0" />
                                <Button x:Name="SaveButton" Content="Save as…" MinWidth="90" Padding="14,4"
                                        Click="OnSave" Margin="0,0,8,0" />
                                <Button Content="Close" MinWidth="90" Padding="14,4" IsCancel="True" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Deliberately no ScrollViewer: a TextBox inside one is measured with unbounded
                         height, grows to the whole document and never shows a scrollbar of its own.
                         The chrome rows are Auto and the pane takes the rest. -->
                    <Grid Margin="26,20,26,20">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- The part's name and its switch on one line, then a single line of text.
                             There used to be a card here holding "Include this part" over a summary,
                             under an intro that said the same things again in other words: the intro's
                             "API keys are replaced" beside the summary's "API keys hidden", and a
                             title labelling a switch that already says what it does. One computed
                             line carries the description and this part's live figures together. -->
                        <DockPanel Grid.Row="0" Margin="0,0,0,4">
                            <ToggleButton x:Name="IncludeToggle" DockPanel.Dock="Right"
                                          Style="{StaticResource ToggleSwitch}" Margin="18,0,0,0"
                                          Checked="OnIncludeChanged" Unchecked="OnIncludeChanged" />
                            <TextBlock x:Name="IncludeLabel" DockPanel.Dock="Right" Text="Include"
                                       VerticalAlignment="Center" FontSize="13" Opacity="0.75" Margin="18,0,0,0" />
                            <TextBlock x:Name="PageTitleText" Style="{StaticResource PageTitle}" Margin="0" />
                        </DockPanel>

                        <TextBlock x:Name="PageIntroText" Grid.Row="1" Style="{StaticResource PageIntro}" Margin="0,0,0,12" />

                        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="10,8" Margin="0">
                            <!-- Wrapped, not scrolled sideways. The longest lines here are the paths
                                 and log lines - the very content this window exists to have read - and
                                 a horizontal scrollbar hides their ends behind an interaction.

                                 The template is ours because this is a text pane, not an input field:
                                 the Fluent TextBox draws an accent underline when focused, which on a
                                 read-only pane says nothing and looks like an edit box waiting for
                                 typing. A ControlTemplate holding only PART_ContentHost keeps
                                 selection and scrolling and drops every bit of input chrome; the card
                                 around it already supplies the border. -->
                            <TextBox x:Name="Pane" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                     FontFamily="Consolas, Courier New" FontSize="12"
                                     Background="Transparent" BorderThickness="0" Padding="0"
                                     HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <TextBox.Resources>
                                    <!-- Cursor is an inherited property in WPF, so without this the
                                         pane's I-beam follows onto its own scrollbar, where every
                                         other Windows app shows the arrow. -->
                                    <Style TargetType="ScrollBar">
                                        <Setter Property="Cursor" Value="Arrow" />
                                    </Style>
                                </TextBox.Resources>
                                <TextBox.Template>
                                    <ControlTemplate TargetType="TextBox">
                                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                                      HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                                      VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}" />
                                    </ControlTemplate>
                                </TextBox.Template>
                            </TextBox>
                        </Border>
                    </Grid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
