<Window x:Class="AchievementOverlay.NotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="False"
        SizeToContent="WidthAndHeight">
    <!-- No RenderTransformOrigin: a translate ignores it, and naming an origin of "0.5,1" would
         state a bottom anchor this window no longer has. -->
    <Window.RenderTransform>
        <TranslateTransform x:Name="SlideTransform" Y="0" />
    </Window.RenderTransform>
    <!-- The fill and every foreground below are assigned in the constructor from PopupPalette, so the
         text colours are derived from the fill rather than hand-tuned for one of them. Leaving copies
         here as design-time values is exactly what would drift. -->
    <Border x:Name="RootBorder"
            CornerRadius="8"
            Padding="12">
        <!-- The whole popup is laid out at a fixed design size and scaled uniformly so the
             font, icon, spacing and text-wrap width always keep the same proportions. -->
        <Border.LayoutTransform>
            <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1" />
        </Border.LayoutTransform>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image x:Name="AchievementIcon"
                   Grid.Column="0"
                   Width="56"
                   Height="56"
                   Stretch="UniformToFill"
                   VerticalAlignment="Top"
                   Margin="0,0,12,0" />
            <DockPanel Grid.Column="1"
                       VerticalAlignment="Stretch">
                <TextBlock x:Name="GameInfoText"
                           DockPanel.Dock="Bottom"
                           FontSize="10"
                           Width="230"
                           TextWrapping="Wrap"
                           Margin="0,4,0,0"
                           Visibility="Collapsed" />
                <StackPanel DockPanel.Dock="Top"
                            VerticalAlignment="Top">
                    <TextBlock x:Name="AchievementName"
                               FontWeight="Bold"
                               FontSize="14"
                               Width="230"
                               TextWrapping="Wrap" />
                    <TextBlock x:Name="AchievementDescription"
                               FontSize="12"
                               Width="230"
                               TextWrapping="Wrap"
                               Margin="0,2,0,0" />
                </StackPanel>
            </DockPanel>
        </Grid>
    </Border>
</Window>
